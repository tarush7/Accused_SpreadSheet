<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Microservice Name -->
  <property name="MICROSERVICE_NAME" value="{cctns-apprehend-service}" />

  <!-- Console Appender -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>
        %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{microservice:-${MICROSERVICE_NAME}}] [%X{correlationId}]
        %logger{36} - %M - Line:%L - %msg%n
      </pattern>
    </encoder>
  </appender>

  <!-- Rolling File Appender -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/cctns-apprehend-service.log</file> <!-- Log file location -->
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>logs/cctns-apprehend-service.log-%d{yyyy-MM-dd}.%d.log</fileNamePattern>
      <maxHistory>7</maxHistory>
      <maxFileSize>10MB</maxFileSize>
    </rollingPolicy>
    <encoder>
      <pattern>
        %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{microservice:-${MICROSERVICE_NAME}}] [%X{correlationId}] %logger{36} - %M - Line:%L - %msg%n
      </pattern>
    </encoder>
  </appender>

  <!-- Root Logger -->
  <root level="INFO">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="FILE" />

  </root>
</configuration>
